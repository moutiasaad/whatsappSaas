# Internal audit output and the original design handoff. Working material, not
# application source: build scripts, coverage dumps and spreadsheet reports that
# describe the codebase rather than form part of it.
/FILES/
/storage/audit/
/audit_report_*.xlsx

# Migration bundles from deploy/replicate/export-bundle.sh. Every secret in the

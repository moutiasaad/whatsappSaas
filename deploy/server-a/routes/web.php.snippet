<?php
// Fragment for Server A's routes/web.php. The marketing app keeps its own
// landing/legal/features routes; only the auth routes change shape because
// they now proxy through Server B instead of hitting a local DB.

use App\Http\Controllers\Auth\LoginController;
use App\Http\Controllers\Auth\RegisterController;
use Illuminate\Support\Facades\Route;

Route::middleware('guest')->group(function () {
    Route::get('/register',  [RegisterController::class, 'show'])->name('register');
    Route::post('/register', [RegisterController::class, 'store'])
        ->middleware('throttle:5,1')
        ->name('register.store');

    Route::get('/login',  [LoginController::class, 'show'])->name('login');
    Route::post('/login', [LoginController::class, 'login'])
        ->middleware('throttle:10,1')
        ->name('login.submit');
});

// Logout is available whether or not a session exists — a stale marketing
// session should always be clearable.
Route::post('/logout', [LoginController::class, 'logout'])->name('logout');

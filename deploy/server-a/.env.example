# ─── Server A (marketing) → Server B (core app) decoupling ────────────────────
# Where the core app lives. Server A hits this base URL for every /api/v1/auth/*
# call and redirects the browser here to finish the SSO handoff.
WAVADESK_APP_URL=https://app.wavadesk.com

# HMAC key shared with Server B for signing the short-lived handoff codes.
# MUST match app.wavadesk.com's WAVADESK_SHARED_SECRET exactly. Rotate on both
# sides at once via CI/CD; a mismatch fails closed (every login rejected).
# Generate: `php -r "echo bin2hex(random_bytes(32));"` — 64 hex chars.
WAVADESK_SHARED_SECRET=

# How long Server A waits on an /api/v1/auth/* call before giving up. Keep
# short so a slow backend can't pin every marketing-page worker.
WAVADESK_API_TIMEOUT=5

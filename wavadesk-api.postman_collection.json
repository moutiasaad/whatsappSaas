        {
          "name": "Release conversation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/conversations/{{conv_id}}/release",
              "host": ["{{base_url}}"],
              "path": ["api", "conversations", "{{conv_id}}", "release"]

        {
          "name": "Close conversation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/conversations/{{conv_id}}/close",
              "host": ["{{base_url}}"],
              "path": ["api", "conversations", "{{conv_id}}", "close"]
            }
          }
        },
        {
          "name": "Reopen conversation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/conversations/{{conv_id}}/reopen",
              "host": ["{{base_url}}"],
              "path": ["api", "conversations", "{{conv_id}}", "reopen"]
            }
          }
        },

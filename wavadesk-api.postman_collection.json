{
  "info": {
    "name": "Wavadesk API",
    "description": "Full API collection for wavadesk.com — Bearer token auth. Call POST /api/auth/login first to get a token, then the collection pre-request script sets it automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",    "value": "https://wavadesk.com", "type": "string" },
    { "key": "token",       "value": "",                      "type": "string", "description": "Auto-set by Login request test script" },
    { "key": "instance_id", "value": "1",                     "type": "string" },
    { "key": "conv_id",     "value": "1",                     "type": "string" },
    { "key": "message_id",  "value": "1",                     "type": "string" },
    { "key": "reply_id",    "value": "1",                     "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    console.log('Token saved:', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@yourtenant.com\",\n  \"password\": \"your-password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Returns a Bearer token. The test script saves it as the `token` collection variable automatically."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Revokes the current Bearer token."
          }
        }
      ]
    },
    {
      "name": "Instances",
      "description": "WhatsApp instance management (role: admin, super_admin). Subscription required.",
      "item": [
        {
          "name": "List instances",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/instances",
              "host": ["{{base_url}}"],
              "path": ["api", "instances"]
            }
          }
        },
        {
          "name": "Create instance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My WhatsApp\",\n  \"team_id\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/instances",
              "host": ["{{base_url}}"],
              "path": ["api", "instances"]
            }
          }
        },
        {
          "name": "Get instance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/instances/{{instance_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "instances", "{{instance_id}}"]
            }
          }
        },
        {
          "name": "Connect instance (get QR)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/instances/{{instance_id}}/connect",
              "host": ["{{base_url}}"],
              "path": ["api", "instances", "{{instance_id}}", "connect"]
            }
          }
        },
        {
          "name": "Get instance status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/instances/{{instance_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "instances", "{{instance_id}}", "status"]
            }
          }
        },
        {
          "name": "Disconnect instance",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/instances/{{instance_id}}/disconnect",
              "host": ["{{base_url}}"],
              "path": ["api", "instances", "{{instance_id}}", "disconnect"]
            }
          }
        },
        {
          "name": "Delete instance",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/instances/{{instance_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "instances", "{{instance_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Conversations",
      "description": "Conversation management. Subscription required.",
      "item": [
        {
          "name": "List conversations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/conversations?tab=all&per_page=25",
              "host": ["{{base_url}}"],
              "path": ["api", "conversations"],
              "query": [
                { "key": "tab",      "value": "all",  "description": "mine | pool | all | closed" },
                { "key": "per_page", "value": "25" },
                { "key": "search",   "value": "",     "disabled": true },
                { "key": "team_id",  "value": "",     "disabled": true },
                { "key": "instance_id", "value": "",  "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Start outbound conversation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instance_id\": {{instance_id}},\n  \"phone\": \"21612345678\",\n  \"message\": \"Hello, how can I help you?\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/conversations/start",
              "host": ["{{base_url}}"],
              "path": ["api", "conversations", "start"]
            },
            "description": "Verifies the number on WhatsApp, finds or creates a conversation, sends the first message."
          }
        },
        {
          "name": "Get conversation",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {

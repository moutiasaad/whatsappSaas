    {
      "name": "Messages",
      "description": "Read and send messages within a conversation.",
      "item": [
        {
          "name": "List messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/conversations/{{conv_id}}/messages?per_page=50",
              "host": ["{{base_url}}"],
              "path": ["api", "conversations", "{{conv_id}}", "messages"],
              "query": [
                { "key": "per_page", "value": "50" },
                { "key": "before_id", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Send message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"text\",\n  \"body\": \"Hello from the API!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/conversations/{{conv_id}}/messages",
              "host": ["{{base_url}}"],
              "path": ["api", "conversations", "{{conv_id}}", "messages"]
            }
          }
        },
        {
          "name": "Send note (internal)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Internal note for the team.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/conversations/{{conv_id}}/notes",
              "host": ["{{base_url}}"],
              "path": ["api", "conversations", "{{conv_id}}", "notes"]
            }
          }
        },
        {
          "name": "Upload media",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "description": "File to upload" },
                { "key": "conversation_id", "value": "{{conv_id}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/media/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "media", "upload"]
            }
          }
        }
      ]
    },

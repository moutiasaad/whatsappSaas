APP_NAME="WhatsApp SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ─── Database ────────────────────────────────────────────────────────────────
# Switch to pgsql or mysql for production

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Broadcasting (Laravel Reverb) ───────────────────────────────────────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=your-app-id
REVERB_APP_KEY=your-app-key
REVERB_APP_SECRET=your-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Queue (use Redis in production) ─────────────────────────────────────────
QUEUE_CONNECTION=redis

# ─── AI — Anthropic Claude ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ─── Payments — Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Payments — PayPal ───────────────────────────────────────────────────────
# TWO MODES, PICK ONE:
#
#   1) STANDARD / email-only (recommended for the simplest setup):
#      Fill just PAYPAL_MODE + PAYPAL_PAYEE_EMAIL. No developer app required.
#      The customer is bounced to PayPal-hosted checkout; funds land in the
#      given email. Payments are confirmed by IPN
#      (POST /payment/paypal/ipn). Works with any personal or business
#      PayPal account.
#
#   2) REST / OAuth v2 Orders:
#      Additionally fill PAYPAL_CLIENT_ID + PAYPAL_CLIENT_SECRET + PAYPAL_WEBHOOK_ID
#      from https://developer.paypal.com/dashboard/applications. When
#      CLIENT_ID is set, the app uses REST instead of Standard. PAYEE_EMAIL
#      still routes funds if the merchant has permission.
PAYPAL_MODE=sandbox
PAYPAL_PAYEE_EMAIL=
PAYPAL_CURRENCY=USD
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ─── WhatsApp Gateways ────────────────────────────────────────────────────────
# Gateway URL and API key are stored per-instance in the database.
# These are optional global defaults used if not set per-instance.
EVOLUTION_API_URL=https://your-evolution-api.com
EVOLUTION_API_KEY=

# ─── Horizon ─────────────────────────────────────────────────────────────────
HORIZON_DOMAIN=
HORIZON_PATH=horizon

# Shared secret for the GitHub push -> deploy webhook (public/deploy-webhook.php)
GITHUB_WEBHOOK_SECRET=

# ─── Split hosting: wavadesk.com (marketing) <-> app.wavadesk.com (core) ─────
# Both hosts run this same codebase. WAVADESK_ROLE decides which half it plays.
#
#   core      — app.wavadesk.com. Owns the database, the WhatsApp webhooks,
#               live chat and every panel. Serves /api/v1/auth/* and redeems
#               the SSO handoff codes. This is the default: leave it unset and
#               the app behaves exactly as the single-host monolith always has.
#
#   marketing — wavadesk.com. Landing page, pricing, register/login forms and
#               subscriptions. Holds no user identity; the auth forms proxy to
#               the core app and hand the browser off to it.
#
# See deploy/split-hosting/README.md for the cutover steps.
WAVADESK_ROLE=core

# Where the core app lives. Read by the marketing host only — it posts every
# /api/v1/auth/* call here and redirects the browser here to finish the
# handoff. Full scheme+host, no trailing slash.
WAVADESK_CORE_URL=https://app.wavadesk.com

# The marketing app's public origin. NOT read by anything yet — kept for the
# logout-return and billing follow-ups. Setting it today changes no behaviour.
# Full scheme+host, no trailing slash.
WAVADESK_MARKETING_ORIGIN=https://wavadesk.com

# One HMAC key, set to the SAME value on both hosts. It signs the short-lived
# handoff codes that carry identity across the domain boundary, and it is what
# the marketing app presents in X-Wavadesk-Caller to prove it is allowed to
# call the auth API at all. Must be >= 32 characters.
#
# A mismatch fails closed: the core app 404s the auth API and rejects every
# handoff. Rotate on both hosts together. Never commit the real value.
# Generate: php -r "echo bin2hex(random_bytes(32));"
WAVADESK_SHARED_SECRET=

# Seconds the marketing app waits on the core app before giving up. Keep it
# short: a slow core app must not pin every worker on the page that sells.
WAVADESK_API_TIMEOUT=5

# CSV of stateful domains for Sanctum's SPA cookie mode. NOT used by the split
# above — that flow is bearer token + signed handoff, with no shared cookie.
# Leave empty unless you are adding a browser-side SPA.
SANCTUM_STATEFUL_DOMAINS=

# ─── Meta / Facebook Messenger (plan_modules key: messenger) ─────────────────
# Credentials for the Messenger channel. Leave empty on hosts that do not sell
# the module. See docs/MESSENGER_SETUP.md for the full Meta-side checklist:
# create Meta app → add Messenger + Facebook Login for Business → paste
# credentials here → set webhook URL + verify token in the Meta dashboard.
META_APP_ID=
META_APP_SECRET=
# Random string you invent, ~32 chars. Paste the SAME value into Meta's
# Messenger webhook settings — the initial GET verification compares byte for
# byte and rejects on mismatch. Generate:
#   php -r "echo bin2hex(random_bytes(24));"
META_WEBHOOK_VERIFY_TOKEN=
# Meta Graph API version. Keep in config so a minor-version bump is one line.
# https://developers.facebook.com/docs/graph-api/changelog/versions
META_GRAPH_VERSION=v21.0
